# Copy to .env (git-ignored) and change SECRET_KEY.
DATABASE_URL=postgresql+psycopg://learnsolo:learnsolo@localhost:5432/learnsolo
# SECRET_KEY signs the login cookies: anyone who knows it could log in as
# anyone. Make a long random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# On the live site (https), set SESSION_COOKIE_SECURE=1 so login cookies are
# only sent over https. Leave it out on your computer (http://localhost).
FLASK_DEBUG=1
