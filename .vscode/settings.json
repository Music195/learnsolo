// Settings for the VS Code editor, used only when this project is open.
// (VS Code allows comments like these in its settings files.)
{
    // Use the project's own Python (the venv), so VS Code knows the
    // installed packages (Flask, SQLAlchemy...) and can run the tests
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

    // The Testing panel (the flask icon on the left) runs the tests with
    // pytest, from backend/, where pytest.ini says where they are.
    // The database must be running: docker compose up -d
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["backend"]
}
